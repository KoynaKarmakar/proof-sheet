# Supabase (Project Settings -> API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Your Railway backend URL, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8080
# true = no login, no backend; shows a built-in sample so you can click around the UI
NEXT_PUBLIC_DEMO_MODE=false
# true = show "Continue with Google" (enable the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH=false
