# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...): server-side only, never put this in the frontend
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=documents

# --- LLM ---
# groq (default, has a free tier) or anthropic
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=300

# Groq (console.groq.com -> API Keys). Free tier, no card needed.
GROQ_API_KEY=
# Digital PDFs: text read from the PDF's text layer
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_TEXT_REASONING_EFFORT=low
# Images and scanned PDF pages
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_REASONING_EFFORT=none
# Sized for the free tier (~8K tokens/minute). Raise on a paid plan
# (e.g. GROQ_MAX_TOKENS=16000, GROQ_TEXT_CHUNK_TOKENS=12000, GROQ_IMAGES_PER_REQUEST=3).
GROQ_MAX_TOKENS=4500
GROQ_TEXT_CHUNK_TOKENS=1800
GROQ_IMAGES_PER_REQUEST=1
GROQ_IMAGE_DPI=150
GROQ_MAX_PAGES=30

# Anthropic (only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=16000
# true = skip the API and return a canned bank-statement extraction (UI testing)
MOCK_EXTRACTION=false

# --- Access ---
# Comma-separated frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional: allow Vercel preview URLs, e.g. #^https://doc-extractor-[a-z0-9-]+\.vercel\.app$#
ALLOWED_ORIGIN_REGEX=
# Sign-up from the login page (email or Google). New accounts can use the app straight away.
# SIGNUP_REQUIRES_APPROVAL=true makes them wait for an admin; SIGNUP_ENABLED=false hides sign-up.
SIGNUP_ENABLED=true
SIGNUP_REQUIRES_APPROVAL=false
# Admins: these users see the Users page and can add, reset and remove logins
ADMIN_EMAILS=
# Optional: only these Supabase users may use the API (admins always can)
ALLOWED_EMAILS=
